<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:counter2.Models"
             x:Class="counter2.MainPage"
             Title="Liczniki"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" MaximumWidthRequest="700">

            <!-- Sekcja: Dodawanie nowego licznika -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    BackgroundColor="#FFFFFF"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Dodaj nowy licznik"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#111827" />

                    <!-- Nazwa licznika -->
                    <Entry x:Name="NameEntry"
                           Placeholder="Nazwa licznika (np. Wypite szklanki wody)"
                           ClearButtonVisibility="WhileEditing" />

                    <!-- Wartość początkowa i Kolor w jednym wierszu -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Entry x:Name="InitialValueEntry"
                               Grid.Column="0"
                               Placeholder="Wartość początkowa (np. 0)"
                               Keyboard="Numeric"
                               ClearButtonVisibility="WhileEditing" />

                        <Picker x:Name="ColorPicker"
                                Grid.Column="1"
                                Title="Kolor licznika"
                                ItemDisplayBinding="{Binding Name}" />
                    </Grid>

                    <!-- Przycisk dodawania -->
                    <Button Text="+ Dodaj licznik"
                            Clicked="OnAddCounterClicked"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- Nagłówek listy liczników -->
            <Grid ColumnDefinitions="*, Auto" Margin="0, 10, 0, 0">
                <Label Text="Twoje liczniki"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       VerticalOptions="Center" />
                <Label x:Name="CounterCountLabel"
                       Grid.Column="1"
                       FontSize="13"
                       TextColor="#6B7280"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Komunikat o braku liczników -->
            <Label x:Name="EmptyStateLabel"
                   Text="Brak liczników. Dodaj swój pierwszy licznik powyżej!"
                   FontSize="14"
                   TextColor="#9CA3AF"
                   HorizontalOptions="Center"
                   IsVisible="False"
                   Margin="0, 20" />

            <!-- Lista dynamicznych liczników -->
            <VerticalStackLayout x:Name="CountersStackLayout"
                                 BindableLayout.ItemsSource="{Binding Counters}"
                                 Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Counter">
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{Binding DisplayBrush}"
                                StrokeThickness="2"
                                BackgroundColor="#FFFFFF"
                                Padding="16">
                            <VerticalStackLayout Spacing="10">

                                <!-- Pasek górny: Nazwa, info o wartości początkowej oraz akcje -->
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#111827"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding InitialValue, StringFormat='Wartość początkowa: {0}'}"
                                               FontSize="12"
                                               TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <!-- Personalizacja koloru -->
                                    <Button Grid.Column="1"
                                            Text="Kolor"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Padding="10, 0"
                                            CornerRadius="6"
                                            BackgroundColor="#F3F4F6"
                                            TextColor="#1F2937"
                                            Clicked="OnChangeColorClicked" />

                                    <!-- Usunięcie licznika -->
                                    <Button Grid.Column="2"
                                            Text="Usuń"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Padding="10, 0"
                                            CornerRadius="6"
                                            BackgroundColor="#EF4444"
                                            TextColor="White"
                                            Clicked="OnDeleteCounterClicked" />
                                </Grid>

                                <!-- Wyświetlanie aktualnej wartości licznika (od lewej strony i większa) -->
                                <Label Text="{Binding Value}"
                                       FontSize="52"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Start"
                                       TextColor="{Binding DisplayColor}"
                                       Margin="2, 4" />

                                <!-- Przyciski manipulacji wartością licznika -->
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                                    <!-- Przycisk minus: zmniejsza wartość o 1 -->
                                    <Button Grid.Column="0"
                                            Text="− 1"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="42"
                                            BackgroundColor="#F3F4F6"
                                            TextColor="#111827"
                                            Clicked="OnDecrementClicked" />

                                    <!-- Przycisk reset: przywraca do wartości początkowej -->
                                    <Button Grid.Column="1"
                                            Text="Reset"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="42"
                                            BackgroundColor="#E5E7EB"
                                            TextColor="#1F2937"
                                            Clicked="OnResetClicked" />

                                    <!-- Przycisk plus: zwiększa wartość o 1 -->
                                    <Button Grid.Column="2"
                                            Text="+ 1"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="42"
                                            BackgroundColor="{Binding DisplayColor}"
                                            TextColor="White"
                                            Clicked="OnIncrementClicked" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
